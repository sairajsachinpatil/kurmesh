# Compose project configuration. Copy to .env and replace values before deployment.
POSTGRES_DB=kurmesh
POSTGRES_USER=kurmesh
POSTGRES_PASSWORD=change-this-before-deployment
DATABASE_URL=postgresql+psycopg://kurmesh:change-this-before-deployment@postgres:5432/kurmesh
REDIS_URL=redis://redis:6379/0
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
FLASK_ENV=production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost
VITE_API_BASE_URL=/api/v1
# Enabled provider registry. The Phase 4B-1 adapter remains disabled below by default.
KURMESH_ENVIRONMENT_PROVIDERS=noaa_nsidc_g10016
KURMESH_ENVIRONMENT_PROVIDER_TIMEOUT_SECONDS=15
# A future provider named "example" would additionally use (do not add credentials to this file):
# KURMESH_ENVIRONMENT_PROVIDER_EXAMPLE_ENABLED=false
# KURMESH_ENVIRONMENT_PROVIDER_EXAMPLE_ENDPOINT=https://configured-by-deployment.example
# KURMESH_ENVIRONMENT_PROVIDER_EXAMPLE_API_KEY=
# Phase 4B-1 NOAA/NSIDC G10016 Antarctic sea-ice adapter. No API key is used.
KURMESH_ENVIRONMENT_PROVIDER_NOAA_NSIDC_G10016_ENABLED=false
KURMESH_ENVIRONMENT_PROVIDER_NOAA_NSIDC_G10016_ENDPOINT=https://noaadata.apps.nsidc.org/NOAA/G10016_V4
KURMESH_ENVIRONMENT_PROVIDER_NOAA_NSIDC_G10016_TIMEOUT_SECONDS=30
KURMESH_ENVIRONMENT_PROVIDER_NOAA_NSIDC_G10016_FRESHNESS_HOURS=48
KURMESH_ENVIRONMENT_PROVIDER_NOAA_NSIDC_G10016_LOOKBACK_DAYS=3
KURMESH_ENVIRONMENT_PROVIDER_NOAA_NSIDC_G10016_MAX_FALLBACK_DISTANCE_KM=75
KURMESH_RUN_LIVE_PROVIDER_TESTS=false
# Phase 4B-2 NOAA GFS 0.25 degree forecast adapter. No API key is used.
KURMESH_ENVIRONMENT_PROVIDER_NOAA_GFS_ENABLED=false
KURMESH_ENVIRONMENT_PROVIDER_NOAA_GFS_ENDPOINT=https://nomads.ncep.noaa.gov/cgi-bin/filter_gfs_0p25.pl
KURMESH_ENVIRONMENT_PROVIDER_NOAA_GFS_TIMEOUT_SECONDS=30
KURMESH_ENVIRONMENT_PROVIDER_NOAA_GFS_FRESHNESS_HOURS=6
KURMESH_ENVIRONMENT_PROVIDER_NOAA_GFS_MAX_FALLBACK_DISTANCE_KM=75
